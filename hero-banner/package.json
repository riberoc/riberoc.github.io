{
  "name": "hero-banner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./components": "./dist/components/index.js"
  },
  "scripts": {
    "build": "esbuild src/index.tsx --bundle --format=esm --external:preact --external:preact/* --outfile=dist/components/Herobanner.js"
  },
  "devDependencies": {
    "esbuild": "^0.27.0",
    "preact": "^10.28.0"
  },
  "quartz": {
    "name": "HeroBanner",
    "displayName": "Hero Banner",
    "description": "Renders a note cover image with its title and modified date.",
    "version": "1.0.0",
    "category": [
      "component"
    ],
    "defaultOptions": {},
    "components": {
      "HeroBanner": {
        "name": "HeroBanner",
        "displayName": "Hero Banner",
        "description": "Renders a note cover image with its title and modified date.",
        "version": "1.0.0",
        "defaultPosition": "beforeBody",
        "defaultPriority": 10
      }
    }
  }
}
